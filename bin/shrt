#!/usr/bin/env bash

# @describe Gray Hat Warfare API client for searching exposed files
# @arg keywords "Your search query" [string]
# @arg page "Page number (1-based)" [int] @default "1"
# @arg size "Number of results per page (1-1000)" [int] @default "100"
# @option -e --ext "File extensions to search for (comma-separated)" [string]
# @option -o --order "Sort by property (size, timestamp)" [string] @choices "size" "timestamp"
# @option -d --direction "Sort direction (asc, desc)" [string] @choices "asc" "desc"
# @option -t --token "API Bearer token (can also use GRAYHAT_API_KEY env var)" [string]
# @flag   -r --regexp "Treat keywords as regular expression"
# @flag   -n --noautocorrect "Do not attempt to autocorrect regex queries"
# @flag   -j --json "Output raw JSON instead of formatted results"
# @flag   -q --quiet "Suppress colored output"
# @flag   -u --urls-only "Output only URLs (one per line)"
# @meta require-tools curl,jq

# ARGC-BUILD {
# This block was generated by argc (https://github.com/sigoden/argc).
# Modifying it manually is not recommended

_argc_run() {
    if [[ "${1:-}" == "___internal___" ]]; then
        _argc_die "error: unsupported ___internal___ command"
    fi
    if [[ "${OS:-}" == "Windows_NT" ]] && [[ -n "${MSYSTEM:-}" ]]; then
        set -o igncr
    fi
    argc__args=("$(basename "$0" .sh)" "$@")
    argc__positionals=()
    _argc_index=1
    _argc_len="${#argc__args[@]}"
    _argc_tools=()
    _argc_parse
    _argc_require_tools "${_argc_tools[@]}"
    if [ -n "${argc__fn:-}" ]; then
        $argc__fn "${argc__positionals[@]}"
    fi
}

_argc_usage() {
    cat <<-'EOF'
Gray Hat Warfare API client for searching exposed files

USAGE: shrt [OPTIONS] [KEYWORDS] [PAGE] [SIZE]

ARGS:
  [KEYWORDS]  "Your search query" [string]
  [PAGE]      "Page number (1-based)" [int] @default "1"
  [SIZE]      "Number of results per page (1-1000)" [int] @default "100"

OPTIONS:
  -e, --ext <EXT>              "File extensions to search for (comma-separated)" [string]
  -o, --order <ORDER>          "Sort by property (size, timestamp)" [string] @choices "size" "timestamp"
  -d, --direction <DIRECTION>  "Sort direction (asc, desc)" [string] @choices "asc" "desc"
  -t, --token <TOKEN>          "API Bearer token (can also use GRAYHAT_API_KEY env var)" [string]
  -r, --regexp                 "Treat keywords as regular expression"
  -n, --noautocorrect          "Do not attempt to autocorrect regex queries"
  -j, --json                   "Output raw JSON instead of formatted results"
  -q, --quiet                  "Suppress colored output"
  -u, --urls-only              "Output only URLs (one per line)"
  -h, --help                   Print help
  -V, --version                Print version
EOF
    exit
}

_argc_version() {
    echo shrt 0.0.0
    exit
}

_argc_parse() {
    local _argc_key _argc_action
    local _argc_subcmds=""
    while [[ $_argc_index -lt $_argc_len ]]; do
        _argc_item="${argc__args[_argc_index]}"
        _argc_key="${_argc_item%%=*}"
        case "$_argc_key" in
        --help | -help | -h)
            _argc_usage
            ;;
        --version | -version | -V)
            _argc_version
            ;;
        --)
            _argc_dash="${#argc__positionals[@]}"
            argc__positionals+=("${argc__args[@]:$((_argc_index + 1))}")
            _argc_index=$_argc_len
            break
            ;;
        --ext | -e)
            _argc_take_args "--ext <EXT>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_ext:-}" ]]; then
                argc_ext="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--ext\` cannot be used multiple times"
            fi
            ;;
        --order | -o)
            _argc_take_args "--order <ORDER>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_order:-}" ]]; then
                argc_order="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--order\` cannot be used multiple times"
            fi
            ;;
        --direction | -d)
            _argc_take_args "--direction <DIRECTION>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_direction:-}" ]]; then
                argc_direction="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--direction\` cannot be used multiple times"
            fi
            ;;
        --token | -t)
            _argc_take_args "--token <TOKEN>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_token:-}" ]]; then
                argc_token="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--token\` cannot be used multiple times"
            fi
            ;;
        --regexp | -r)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--regexp\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_regexp:-}" ]]; then
                _argc_die "error: the argument \`--regexp\` cannot be used multiple times"
            else
                argc_regexp=1
            fi
            ;;
        --noautocorrect | -n)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--noautocorrect\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_noautocorrect:-}" ]]; then
                _argc_die "error: the argument \`--noautocorrect\` cannot be used multiple times"
            else
                argc_noautocorrect=1
            fi
            ;;
        --json | -j)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--json\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_json:-}" ]]; then
                _argc_die "error: the argument \`--json\` cannot be used multiple times"
            else
                argc_json=1
            fi
            ;;
        --quiet | -q)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--quiet\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_quiet:-}" ]]; then
                _argc_die "error: the argument \`--quiet\` cannot be used multiple times"
            else
                argc_quiet=1
            fi
            ;;
        --urls-only | -u)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--urls-only\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_urls_only:-}" ]]; then
                _argc_die "error: the argument \`--urls-only\` cannot be used multiple times"
            else
                argc_urls_only=1
            fi
            ;;
        *)
            if _argc_maybe_flag_option "-" "$_argc_item"; then
                _argc_die "error: unexpected argument \`$_argc_key\` found"
            fi
            argc__positionals+=("$_argc_item")
            _argc_index=$((_argc_index + 1))
            ;;
        esac
    done
    _argc_tools=(curl jq)
    if [[ -n "${_argc_action:-}" ]]; then
        $_argc_action
    else
        if [[ "${argc__positionals[0]:-}" == "help" ]] && [[ "${#argc__positionals[@]}" -eq 1 ]]; then
            _argc_usage
        fi
        _argc_match_positionals 0 0 0
        local values_index values_size
        IFS=: read -r values_index values_size <<<"${_argc_match_positionals_values[0]:-}"
        if [[ -n "$values_index" ]]; then
            argc_keywords="${argc__positionals[values_index]}"
        fi
        IFS=: read -r values_index values_size <<<"${_argc_match_positionals_values[1]:-}"
        if [[ -n "$values_index" ]]; then
            argc_page="${argc__positionals[values_index]}"
        fi
        IFS=: read -r values_index values_size <<<"${_argc_match_positionals_values[2]:-}"
        if [[ -n "$values_index" ]]; then
            argc_size="${argc__positionals[values_index]}"
        fi
    fi
}

_argc_take_args() {
    _argc_take_args_values=()
    _argc_take_args_len=0
    local param="$1" min="$2" max="$3" signs="$4" delimiter="$5"
    if [[ "$min" -eq 0 ]] && [[ "$max" -eq 0 ]]; then
        return
    fi
    local _argc_take_index=$((_argc_index + 1)) _argc_take_value
    if [[ "$_argc_item" == *=* ]]; then
        _argc_take_args_values=("${_argc_item##*=}")
    else
        while [[ $_argc_take_index -lt $_argc_len ]]; do
            _argc_take_value="${argc__args[_argc_take_index]}"
            if _argc_maybe_flag_option "$signs" "$_argc_take_value"; then
                if [[ "${#_argc_take_value}" -gt 1 ]]; then
                    break
                fi
            fi
            _argc_take_args_values+=("$_argc_take_value")
            _argc_take_args_len=$((_argc_take_args_len + 1))
            if [[ "$_argc_take_args_len" -ge "$max" ]]; then
                break
            fi
            _argc_take_index=$((_argc_take_index + 1))
        done
    fi
    if [[ "${#_argc_take_args_values[@]}" -lt "$min" ]]; then
        _argc_die "error: incorrect number of values for \`$param\`"
    fi
    if [[ -n "$delimiter" ]] && [[ "${#_argc_take_args_values[@]}" -gt 0 ]]; then
        local item values arr=()
        for item in "${_argc_take_args_values[@]}"; do
            IFS="$delimiter" read -r -a values <<<"$item"
            arr+=("${values[@]}")
        done
        _argc_take_args_values=("${arr[@]}")
    fi
}

_argc_match_positionals() {
    _argc_match_positionals_values=()
    _argc_match_positionals_len=0
    local params=("$@")
    local args_len="${#argc__positionals[@]}"
    if [[ $args_len -eq 0 ]]; then
        return
    fi
    local params_len=$# arg_index=0 param_index=0
    while [[ $param_index -lt $params_len && $arg_index -lt $args_len ]]; do
        local takes=0
        if [[ "${params[param_index]}" -eq 1 ]]; then
            if [[ $param_index -eq 0 ]] &&
                [[ ${_argc_dash:-} -gt 0 ]] &&
                [[ $params_len -eq 2 ]] &&
                [[ "${params[$((param_index + 1))]}" -eq 1 ]] \
                ; then
                takes=${_argc_dash:-}
            else
                local arg_diff=$((args_len - arg_index)) param_diff=$((params_len - param_index))
                if [[ $arg_diff -gt $param_diff ]]; then
                    takes=$((arg_diff - param_diff + 1))
                else
                    takes=1
                fi
            fi
        else
            takes=1
        fi
        _argc_match_positionals_values+=("$arg_index:$takes")
        arg_index=$((arg_index + takes))
        param_index=$((param_index + 1))
    done
    if [[ $arg_index -lt $args_len ]]; then
        _argc_match_positionals_values+=("$arg_index:$((args_len - arg_index))")
    fi
    _argc_match_positionals_len=${#_argc_match_positionals_values[@]}
    if [[ $params_len -gt 0 ]] && [[ $_argc_match_positionals_len -gt $params_len ]]; then
        local index="${_argc_match_positionals_values[params_len]%%:*}"
        _argc_die "error: unexpected argument \`${argc__positionals[index]}\` found"
    fi
}

_argc_maybe_flag_option() {
    local signs="$1" arg="$2"
    if [[ -z "$signs" ]]; then
        return 1
    fi
    local cond=false
    if [[ "$signs" == *"+"* ]]; then
        if [[ "$arg" =~ ^\+[^+].* ]]; then
            cond=true
        fi
    elif [[ "$arg" == -* ]]; then
        if (( ${#arg} < 3 )) || [[ ! "$arg" =~ ^---.* ]]; then
            cond=true
        fi
    fi
    if [[ "$cond" == "false" ]]; then
        return 1
    fi
    local value="${arg%%=*}"
    if [[ "$value" =~ [[:space:]] ]]; then
        return 1
    fi
    return 0
}

_argc_require_tools() {
    local tool missing_tools=()
    for tool in "$@"; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            missing_tools+=("$tool")
        fi
    done
    if [[ "${#missing_tools[@]}" -gt 0 ]]; then
        echo "error: missing tools: ${missing_tools[*]}" >&2
        exit 1
    fi
}

_argc_die() {
    if [[ $# -eq 0 ]]; then
        cat
    else
        echo "$*" >&2
    fi
    exit 1
}

_argc_run "$@"

# ARGC-BUILD }

setup_colors() {
  if [ "$argc_quiet" = 1 ] || [ -z "$TERM" ] || [ "$TERM" = "dumb" ]; then
    bold="" reset="" blue="" green="" yellow="" cyan="" magenta="" red=""
  else
    bold=$(tput bold) reset=$(tput sgr0) blue=$(tput setaf 4) green=$(tput setaf 2)
    yellow=$(tput setaf 3) cyan=$(tput setaf 6) magenta=$(tput setaf 5) red=$(tput setaf 1)
  fi
}
setup_colors

get_api_token() {
  if [ -n "$argc_token" ]; then
    echo "$argc_token"
  elif [ -n "$GRAYHAT_API_KEY" ]; then
    echo "$GRAYHAT_API_KEY"
  elif [ -f "$HOME/.config/grayhatwarfare/api_token" ]; then
    cat "$HOME/.config/grayhatwarfare/api_token"
  else
    echo "${red}Error:${reset} No Gray Hat Warfare API token found." >&2
    echo "Either:" >&2
    echo "  1. Pass it with --token" >&2
    echo "  2. Set GRAYHAT_API_KEY environment variable" >&2
    echo "  3. Save it to ~/.config/grayhatwarfare/api_token" >&2
    exit 1
  fi
}
API_KEY=$(get_api_token)
API_BASE="https://shorteners.grayhatwarfare.com/api/v1"

print_kv() {
  printf "${bold}%s:${reset} %s\n" "$1" "$2"
}

print_section() {
  printf "\n${bold}%s:${reset}\n" "$1"
}

format_size() {
  local bytes=$1
  if [ "$bytes" -lt 1024 ]; then
    echo "${bytes}B"
  elif [ "$bytes" -lt 1048576 ]; then
    echo "$(((bytes + 512) / 1024))KB"
  elif [ "$bytes" -lt 1073741824 ]; then
    echo "$(((bytes + 524288) / 1048576))MB"
  else
    echo "$(((bytes + 536870912) / 1073741824))GB"
  fi
}

format_timestamp() {
  local timestamp=$1
  date -d "@${timestamp}" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || date -r "${timestamp}" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "N/A"
}

make_request() {
  local endpoint="$1"
  local params="$2"
  local url="${API_BASE}/${endpoint}?${params}"
  local response=$(curl -s -H "Authorization: Bearer ${API_KEY}" "$url")

  if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
    error_msg=$(echo "$response" | jq -r '.error')
    printf "${red}Error:${reset} API returned: ${red}%s${reset}\n" "$error_msg" >&2
    exit 1
  fi

  if ! echo "$response" | jq empty >/dev/null 2>&1; then
    printf "${red}Error:${reset} Invalid JSON response from API\n" >&2
    exit 1
  fi

  echo "$response"
}

build_search_params() {
  local params=""

  local start=$(((argc_page - 1) * argc_size))
  params="start=${start}&limit=${argc_size}"

  params="${params}&keywords=$(printf '%s' "$argc_keywords" | jq -sRr @uri)"

  [ -n "$argc_ext" ] && params="${params}&ext=${argc_ext}"
  [ -n "$argc_order" ] && params="${params}&order=${argc_order}"
  [ -n "$argc_direction" ] && params="${params}&direction=${argc_direction}"
  [ "$argc_regexp" = 1 ] && params="${params}&regexp=1"
  [ "$argc_noautocorrect" = 1 ] && params="${params}&noautocorrect=1"

  echo "$params"
}

show_help() {
  echo "${bold}Gray Hat Warfare API Client${reset}"
  echo ""
  echo "${bold}Description:${reset}"
  echo "  Search and fetch exposed files from Gray Hat Warfare's database"
  echo ""
  echo "${bold}Usage:${reset}"
  echo "  ${green}$(basename "$0") KEYWORDS [PAGE] [SIZE] [OPTIONS]${reset}"
  echo ""
  echo "${bold}Examples:${reset}"
  echo "  ${green}$(basename "$0") \"password\"${reset}"
  echo "  ${green}$(basename "$0") \"doe\" 1 100 --ext \"pdf\"${reset}"
  echo "  ${green}$(basename "$0") \"config\" 2 50 --ext \"json,xml\" --order size --direction desc${reset}"
  echo "  ${green}$(basename "$0") \".*\\.env$\" 1 10 --regexp${reset}"
  echo "  ${green}$(basename "$0") \"api\" 1 100 --urls-only > found_urls.txt${reset}"
  echo ""
  echo "${bold}Search Options:${reset}"
  echo "  ${yellow}-e, --ext${reset}           File extensions (comma-separated)"
  echo "  ${yellow}-o, --order${reset}         Sort by: size, timestamp"
  echo "  ${yellow}-d, --direction${reset}     Sort direction: asc, desc"
  echo "  ${yellow}-r, --regexp${reset}        Treat keywords as regular expression"
  echo "  ${yellow}-n, --noautocorrect${reset} Don't autocorrect regex queries"
  echo ""
  echo "${bold}Output Options:${reset}"
  echo "  ${yellow}-j, --json${reset}          Output raw JSON"
  echo "  ${yellow}-u, --urls-only${reset}     Output only URLs (one per line)"
  echo "  ${yellow}-q, --quiet${reset}         Suppress colored output"
  echo ""
  echo "${bold}Authentication:${reset}"
  echo "  ${yellow}-t, --token${reset}         API Bearer token"
  echo ""
  echo "${bold}Note:${reset} You can also set the GRAYHAT_API_KEY environment variable"
  echo "      or save your token to ~/.config/grayhatwarfare/api_token"
}

format_search_results() {
  local response="$1"
  local urls_count=$(echo "$response" | jq -r '.urlsCount')
  local premium_count=$(echo "$response" | jq -r '.premiumUrlsCount // "N/A"')
  local start=$(echo "$response" | jq -r '.start')
  local limit=$(echo "$response" | jq -r '.limit')
  local actual_count=$(echo "$response" | jq -r '.urls | length')
  local end_index=$((start + actual_count - 1))

  if [ "$argc_urls_only" = 1 ]; then
    echo "$response" | jq -r '.urls[].url'
    return
  fi

  printf "${bold}Search Results${reset}\n"
  printf "${bold}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}\n\n"

  print_kv "Total Matches" "${green}${urls_count}${reset}"
  [ "$premium_count" != "N/A" ] && print_kv "Premium Matches" "${yellow}${premium_count}${reset}"
  printf "${bold}Page:${reset} ${cyan}%s${reset} (${yellow}%s${reset}-${yellow}%s${reset} of ${yellow}%s${reset})\n" "$argc_page" "$((start + 1))" "$((end_index + 1))" "$urls_count"

  if [ "$actual_count" -eq 0 ]; then
    printf "\n${yellow}No results found.${reset}\n"
    return
  fi

  print_section "Files Found"
  echo "$response" | jq -r '.urls[] | "\(.url)|\(.size)|\(.ext // "N/A")|\(.mimeType // "N/A")|\(.shortUrl // "N/A")|\(.discoveredTimestamp)|\(.subDomain)|\(.regDomain)"' |
    while IFS="|" read -r url size ext mime_type short_url timestamp subdomain reg_domain; do
      size_formatted=$(format_size "$size")
      timestamp_formatted=$(format_timestamp "$timestamp")

      printf "${bold}• ${green}%s${reset}\n" "$url"
      printf "  ${cyan}Domain:${reset} ${blue}%s${reset}" "$reg_domain"
      [ "$subdomain" != "$reg_domain" ] && printf " (${magenta}%s${reset})" "$subdomain"
      printf "\n"
      printf "  ${cyan}Size:${reset} ${yellow}%s${reset}" "$size_formatted"
      [ "$ext" != "N/A" ] && printf " ${cyan}Extension:${reset} ${yellow}%s${reset}" "$ext"
      printf "\n"
      [ "$mime_type" != "N/A" ] && printf "  ${cyan}MIME Type:${reset} ${magenta}%s${reset}\n" "$mime_type"
      printf "  ${cyan}Discovered:${reset} ${yellow}%s${reset}\n" "$timestamp_formatted"
      [ "$short_url" != "N/A" ] && printf "  ${cyan}Short URL:${reset} ${blue}%s${reset}\n" "$short_url"
      printf "\n"
    done
}

argc_page=${argc_page:-1}
argc_size=${argc_size:-100}

if [ -z "$argc_keywords" ]; then
  echo "${red}Error:${reset} Keywords are required" >&2
  show_help
  exit 1
fi

if [ "$argc_size" -lt 1 ] || [ "$argc_size" -gt 1000 ]; then
  echo "${red}Error:${reset} Size must be between 1 and 1000." >&2
  exit 1
fi

if [ "$argc_page" -lt 1 ]; then
  echo "${red}Error:${reset} Page must be 1 or greater." >&2
  exit 1
fi

params=$(build_search_params)
start_index=$(((argc_page - 1) * argc_size))
response=$(make_request "files/${start_index}/${argc_size}" "$params")

if [ "$argc_json" = 1 ]; then
  echo "$response" | jq
else
  format_search_results "$response"
fi
